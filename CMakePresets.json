{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "hidden": false,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "IMG_SIZE": "128",
        "KERNEL_POS": "0x00100000",
        "KERNEL_STACK_SIZE": "0x4000"
      }
    }
  ]
}
